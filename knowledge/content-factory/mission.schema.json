{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://request.local/schemas/mission-v1.json",
  "title": "REQuest Content Factory Mission",
  "type": "object",
  "required": ["schemaVersion", "id", "locale", "sourceIds", "factDigest", "datasets", "activities", "acceptance", "executionTests", "review"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z]+-(?:[0-9]{3}|BOSS-[0-9]{2})$"},
    "locale": {"const": "ru-RU"},
    "sourceIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "factDigest": {"type": "array", "minItems": 1},
    "datasets": {"type": "array", "minItems": 1},
    "activities": {"type": "array", "minItems": 2},
    "executionTests": {"type": "array", "minItems": 1},
    "review": {
      "type": "object",
      "required": ["executionValidated", "technicalReview", "russianEdit", "licenseReview"]
    }
  }
}
