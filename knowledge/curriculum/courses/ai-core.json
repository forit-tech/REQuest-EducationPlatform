[
  {
    "id": "ai-intro",
    "title": "Что вообще такое AI",
    "domain": "ai",
    "level": 1,
    "status": "authored",
    "goal": "Словарь до всякой практики: AI, ML, глубокое обучение, генеративные модели, параметр, датасет, обучение, вывод, контекст.",
    "prerequisites": ["fund-computer"],
    "skills": ["ai-vocabulary"],
    "modules": [
      { "id": "ai-what-is", "title": "AI, ML и глубокое обучение", "class": "простая", "concepts": ["матрёшка понятий", "правила против обучения на данных", "где что применяют"], "practice": ["read", "quiz"], "interactions": 5, "skills": ["ai-vocabulary"], "prerequisites": [] },
      { "id": "ai-model-concept", "title": "Что такое модель", "class": "важная", "concepts": ["функция с настраиваемыми числами", "параметр", "веса как результат обучения"], "practice": ["read", "modify", "quiz"], "interactions": 6, "skills": ["ai-vocabulary"], "prerequisites": ["ai-what-is"] },
      { "id": "ai-generative", "title": "Генеративные модели", "class": "простая", "concepts": ["предсказать метку против сгенерировать продолжение", "текст, изображение, звук"], "practice": ["read", "quiz"], "interactions": 5, "skills": ["ai-vocabulary"], "prerequisites": ["ai-model-concept"] },
      { "id": "ai-dataset", "title": "Датасет", "class": "простая", "concepts": ["примеры", "разметка", "качество данных решает"], "practice": ["read", "modify", "quiz"], "interactions": 5, "skills": ["ai-vocabulary"], "prerequisites": ["ai-model-concept"] },
      { "id": "ai-training-vs-inference", "title": "Обучение и вывод", "class": "важная", "concepts": ["дорогое обучение один раз", "дешёвый вывод много раз", "веса не меняются при ответе"], "practice": ["read", "quiz", "case"], "interactions": 7, "skills": ["ai-vocabulary"], "prerequisites": ["ai-dataset"] },
      { "id": "ai-context-concept", "title": "Контекст", "class": "важная", "concepts": ["модель не помнит прошлый диалог сама", "всё нужное подаётся на вход", "окно ограничено"], "practice": ["read", "modify", "quiz", "case"], "interactions": 7, "skills": ["ai-vocabulary"], "prerequisites": ["ai-training-vs-inference"] },
      { "id": "ai-limits", "title": "Чего модель не умеет", "class": "важная", "concepts": ["уверенный неверный ответ", "устаревшие знания", "отсутствие доступа к твоим данным"], "practice": ["read", "quiz", "case"], "interactions": 6, "skills": ["ai-vocabulary"], "prerequisites": ["ai-context-concept"] }
    ]
  },
  {
    "id": "ai-math",
    "title": "Математика для AI: быстрый разбор",
    "domain": "ai",
    "level": 2,
    "status": "authored",
    "goal": "Компактный разбор того минимума, который встречается в AI-курсах: вектор, матрица, производная, градиент, вероятность. Это мост и напоминание, а не замена: глубина живёт в mth-linear, mth-calculus, mth-optimization и mth-probability.",
    "prerequisites": ["py-basics", "ai-intro"],
    "skills": ["math-linear", "math-calculus", "math-probability"],
    "modules": [
      { "id": "math-vector", "title": "Вектор — это список чисел", "class": "важная", "concepts": ["вектор как признаки объекта", "размерность", "вектор в Python"], "practice": ["read", "modify", "fill", "write", "quiz"], "interactions": 7, "skills": ["math-linear"], "prerequisites": [] },
      { "id": "math-vector-ops", "title": "Операции над векторами", "class": "важная", "concepts": ["сложение", "умножение на число", "длина вектора"], "practice": ["read", "modify", "fill", "write", "fix", "quiz"], "interactions": 8, "skills": ["math-linear"], "prerequisites": ["math-vector"] },
      { "id": "math-dot-product", "title": "Скалярное произведение", "class": "важная", "concepts": ["сумма произведений", "мера совпадения направлений", "основа всего дальнейшего"], "practice": ["read", "modify", "fill", "write", "fix", "quiz"], "interactions": 9, "skills": ["math-linear"], "prerequisites": ["math-vector-ops"] },
      { "id": "math-matrix", "title": "Матрица", "class": "важная", "concepts": ["таблица чисел", "строки и столбцы", "форма"], "practice": ["read", "modify", "fill", "write", "quiz"], "interactions": 8, "skills": ["math-linear"], "prerequisites": ["math-dot-product"] },
      { "id": "math-matmul", "title": "Умножение матриц", "class": "сложная", "concepts": ["строка на столбец", "правило совпадения форм", "почему это ядро нейросети"], "practice": ["read", "modify", "fill", "write", "fix", "quiz", "case"], "interactions": 11, "skills": ["math-linear"], "prerequisites": ["math-matrix"] },
      { "id": "math-function", "title": "Функция и график", "class": "простая", "concepts": ["вход и выход", "график", "минимум функции"], "practice": ["read", "modify", "quiz"], "interactions": 6, "skills": ["math-calculus"], "prerequisites": ["math-matmul"] },
      { "id": "math-derivative", "title": "Производная как наклон", "class": "сложная", "concepts": ["скорость изменения", "знак наклона", "численная производная в коде"], "practice": ["read", "modify", "fill", "write", "quiz", "case"], "interactions": 10, "skills": ["math-calculus"], "prerequisites": ["math-function"] },
      { "id": "math-gradient", "title": "Градиент", "class": "сложная", "concepts": ["производные по каждому параметру", "направление роста", "антиградиент как путь вниз"], "practice": ["read", "modify", "write", "fix", "quiz", "case"], "interactions": 11, "skills": ["math-calculus"], "prerequisites": ["math-derivative"] },
      { "id": "math-optimization", "title": "Градиентный спуск", "class": "сложная", "concepts": ["шаг обучения", "итерации", "застревание и расхождение"], "practice": ["read", "modify", "write", "fix", "quiz", "case"], "interactions": 12, "skills": ["math-calculus"], "prerequisites": ["math-gradient"] },
      { "id": "math-probability", "title": "Вероятность и распределение", "class": "важная", "concepts": ["сумма вероятностей равна единице", "распределение по вариантам", "как числа превращаются в вероятности"], "practice": ["read", "modify", "fill", "write", "quiz"], "interactions": 9, "skills": ["math-probability"], "prerequisites": ["math-optimization"] }
    ]
  },
  {
    "id": "ai-ml-fundamentals",
