      { "id": "ml-overfitting", "title": "Переобучение", "class": "сложная", "concepts": ["выучил примеры наизусть", "разрыв обучения и теста", "как заметить по графику"], "practice": ["read", "modify", "write", "fix", "quiz", "case"], "interactions": 10, "skills": ["ml-basics"], "prerequisites": ["ml-first-model"] },
