      { "id": "pt-inference", "title": "Режим вывода и сохранение", "class": "важная", "concepts": ["eval", "no_grad", "сохранение и загрузка весов"], "practice": ["read", "modify", "write", "fix", "quiz"], "interactions": 8, "skills": ["pytorch-training"], "prerequisites": ["pt-training"] }
