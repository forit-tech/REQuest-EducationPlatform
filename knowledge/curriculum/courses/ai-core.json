  {
    "id": "ai-neural-networks",
    "title": "Нейросети по шагам",
    "domain": "ai",
    "level": 3,
    "status": "authored",
    "goal": "Как учится нейросеть: нейрон, слой, прямой проход, функция потерь, обратное распространение, оптимизатор и цикл обучения. Матанализ и оптимизация не переобъясняются — они в mth-calculus, mth-optimization и mth-ml-models.",
    "prerequisites": ["ai-ml-fundamentals"],
    "skills": ["nn-forward", "nn-training"],
    "modules": [
      { "id": "nn-neuron", "title": "Один нейрон", "class": "важная", "concepts": ["вход", "вес", "смещение", "сумма"], "practice": ["read", "modify", "fill", "write", "quiz"], "interactions": 8, "skills": ["nn-forward"], "prerequisites": [] },
      { "id": "nn-activation", "title": "Функция активации", "class": "важная", "concepts": ["зачем нелинейность", "ReLU", "сигмоида"], "practice": ["read", "modify", "write", "quiz"], "interactions": 7, "skills": ["nn-forward"], "prerequisites": ["nn-neuron"] },
      { "id": "nn-layer", "title": "Слой", "class": "важная", "concepts": ["много нейронов сразу", "матрица весов", "форма тензора"], "practice": ["read", "modify", "fill", "write", "fix", "quiz"], "interactions": 8, "skills": ["nn-forward"], "prerequisites": ["nn-activation"] },
      { "id": "nn-forward", "title": "Прямой проход", "class": "важная", "concepts": ["слой за слоем", "выход сети", "предсказание"], "practice": ["read", "modify", "write", "quiz", "case"], "interactions": 8, "skills": ["nn-forward"], "prerequisites": ["nn-layer"] },
      { "id": "nn-loss", "title": "Функция потерь", "class": "важная", "concepts": ["насколько сеть ошиблась", "MSE", "кросс-энтропия"], "practice": ["read", "modify", "write", "quiz"], "interactions": 7, "skills": ["nn-training"], "prerequisites": ["nn-forward"] },
      { "id": "nn-gradient", "title": "Градиент", "class": "сложная", "concepts": ["куда двигать вес", "производная как направление", "шаг обучения"], "practice": ["read", "modify", "write", "fix", "quiz", "case"], "interactions": 10, "skills": ["nn-training"], "prerequisites": ["nn-loss"] },
      { "id": "nn-backprop", "title": "Обратное распространение", "class": "сложная", "concepts": ["ошибка назад по слоям", "цепное правило на пальцах", "обновление весов"], "practice": ["read", "modify", "write", "fix", "quiz", "case"], "interactions": 12, "skills": ["nn-training"], "prerequisites": ["nn-gradient"] },
      { "id": "nn-optimizer", "title": "Оптимизатор", "class": "важная", "concepts": ["SGD", "момент", "Adam", "скорость обучения"], "practice": ["read", "modify", "write", "quiz", "case"], "interactions": 8, "skills": ["nn-training"], "prerequisites": ["nn-backprop"] },
      { "id": "nn-init", "title": "Инициализация весов", "class": "важная", "concepts": ["нулями нельзя", "масштаб начальных весов", "затухание и взрыв градиентов"], "practice": ["read", "modify", "fix", "quiz", "case"], "interactions": 9, "skills": ["nn-forward", "nn-training"], "prerequisites": ["nn-optimizer"] },
      { "id": "nn-normalization", "title": "Нормализация внутри сети", "class": "важная", "concepts": ["зачем нормализовать активации", "нормализация по батчу и по слою", "что меняется в обучении"], "practice": ["read", "modify", "fix", "quiz", "case"], "interactions": 9, "skills": ["nn-forward", "nn-training"], "prerequisites": ["nn-init"] },
      { "id": "nn-regularization", "title": "Регуляризация", "class": "важная", "concepts": ["случайное отключение нейронов", "штраф на веса", "ранняя остановка"], "practice": ["read", "modify", "write", "fix", "quiz", "case"], "interactions": 9, "skills": ["nn-forward", "nn-training"], "prerequisites": ["nn-normalization"] },
      { "id": "nn-training-loop", "title": "Цикл обучения целиком", "class": "сложная", "concepts": ["эпоха", "батч", "валидация", "переобучение видно на графике"], "practice": ["read", "write", "fix", "quiz", "case"], "interactions": 12, "skills": ["nn-training"], "prerequisites": ["nn-regularization"] }
    ]
  },
