      { "id": "ml-features-labels", "title": "Признаки и ответ", "class": "важная", "concepts": ["X и y", "один объект — одна строка", "что модель видит на входе"], "practice": ["read", "modify", "fill", "write", "quiz"], "interactions": 7, "skills": ["ml-basics"], "prerequisites": ["ml-task"] },
