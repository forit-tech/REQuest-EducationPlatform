# Скопируй этот файл в .env и подставь свои значения.
# .env добавлен в .gitignore и в сборку приложения не попадает.
# ВАЖНО: токен нельзя класть в файлы внутри src/ — Vite вшивает их в клиентский бандл,
# и токен окажется в открытом виде у каждого, кто откроет приложение.

TELEGRAM_BOT_TOKEN=

# Порт локального приёма событий из приложения
BOT_PORT=8787

# Во сколько присылать ежедневное напоминание (по времени этой машины)
REMINDER_HOUR=19
REMINDER_MINUTE=0

# ----------------------------------------------------------------- QA-сборка
# Переменные ниже нужны только для локальной сборки разработчика
# (`npm run dev:admin`, `npm run build:admin`) и кладутся в .env.admin.local,
# который закрыт от git. В публичной сборке их нет, поэтому учётная запись
# администратора там не создаётся и проверочная запись в бандл не попадает.
#
# VITE_ADMIN_BUILD=true
# VITE_ADMIN_VERIFIER=<соль в hex>:<производный ключ PBKDF2 в hex>
#
# Значения генерируются локально; сам пароль не хранится нигде, кроме
# ADMIN_CREDENTIALS.local.txt на машине разработчика.
