{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "build/engine",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/types.ts",
    "src/core/tasks.ts",
    "src/core/storage.ts",
    "src/core/task/**/*.ts",
    "src/core/runtime/**/*.ts",
    "src/core/diagnostic/**/*.ts"
  ]
}
