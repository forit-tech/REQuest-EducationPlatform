{
  "name": "reduquest-learning-platform",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Платформа обучения IT-профессиям в формате desktop-приложения.",
  "author": {
    "name": "FORIT TECH",
    "email": "xenonime@bk.ru"
  },
  "homepage": "https://github.com/forit-tech/REQuest-EducationPlatform",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "content:validate": "node ./scripts/validate-content.mjs",
    "quality:report": "node ./scripts/classify-courses.mjs",
    "api:audit": "node ./scripts/audit-api-introduction.mjs",
    "quality:report:baseline": "node ./scripts/classify-courses.mjs --update-baseline",
    "curriculum:validate": "node ./scripts/validate-curriculum.mjs",
    "sprites:normalize": "python ./scripts/normalize-sprites.py",
    "sprites:check": "python ./scripts/check-sprites.py",
    "bot": "node ./bot/bot.mjs",
    "build": "npm run content:validate && npm run quality:report && npm run curriculum:validate && npm run engine:test && npm run quality:test && npm run quality:validate && tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-desktop.ps1",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "update": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/update.ps1",
    "update:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/update.ps1 -CheckOnly",
    "engine:build": "tsc -p tsconfig.engine.json && node ./scripts/esm-extensions.mjs build/engine",
    "engine:test": "npm run engine:build && node ./scripts/engine-tests.mjs",
    "quality:validate": "npm run engine:build && node ./scripts/validate-quality.mjs",
    "quality:baseline": "npm run engine:build && node ./scripts/validate-quality.mjs --update-baseline",
    "quality:test": "npm run engine:build && node ./scripts/quality-tests.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@vitejs/plugin-react": "latest",
    "codemirror": "^6.0.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "typescript": "latest"
  }
}
